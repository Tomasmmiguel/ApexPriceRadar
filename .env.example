# ==============================================================================
# APEX PRICE ENGINE - Environment Configuration Template
# Duplicate this file to '.env' and fill in your real credentials.
# ==============================================================================

# Database
# Use SQLite for local development or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./data/apex_prices.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/apex_prices

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CONCURRENCY_LIMIT=3
DEFAULT_SCRAPE_DELAY_SECONDS=1.5

# Telegram Bot Alerting (Optional - alerts will be logged if disabled)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# Price Analysis Rules
MIN_DISCOUNT_PERCENT_ALERT=10.0
HISTORICAL_WINDOW_DAYS=30
